<?xml version="1.0" encoding="utf-8"?>
<!-- 主窗口布局：导航、页面内容、状态提示和底部操作栏。 -->
<Window
  x:Class="WinUIMacro.UI.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="WinUIMacro"
>
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TitleBar x:Name="AppTitleBar" Title="WinUIMacro" />

    <SelectorBar
      x:Name="RootSelectorBar"
      Grid.Row="1"
      Margin="16,0,16,0"
      IsEnabled="{x:Bind ViewModel.CanChangeWorkspace, Mode=OneWay}"
      SelectionChanged="RootSelectorBar_SelectionChanged"
    >
      <SelectorBarItem x:Name="MacroListSelectorItem" Text="宏列表" Tag="Macros">
        <SelectorBarItem.Icon>
          <FontIcon Glyph="&#xE8FD;" />
        </SelectorBarItem.Icon>
      </SelectorBarItem>
      <SelectorBarItem x:Name="BindingsSelectorItem" Text="触发键绑定" Tag="Bindings">
        <SelectorBarItem.Icon>
          <FontIcon Glyph="&#xE765;" />
        </SelectorBarItem.Icon>
      </SelectorBarItem>
    </SelectorBar>

    <Grid
      x:Name="BackBar"
      Grid.Row="1"
      Visibility="Collapsed"
      MinHeight="48"
      Padding="12,0,8,0"
      ColumnSpacing="8"
      DataContext="{x:Bind ViewModel.SelectedMacro, Mode=OneWay}"
    >
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button
        Width="36"
        Height="32"
        Padding="0"
        VerticalAlignment="Center"
        Background="Transparent"
        BorderBrush="Transparent"
        Click="BackButton_Click"
        IsEnabled="{x:Bind ViewModel.CanChangeWorkspace, Mode=OneWay}"
        ToolTipService.ToolTip="返回宏列表"
      >
        <FontIcon Glyph="&#xE72B;" FontSize="14" />
      </Button>
      <TextBox
        Grid.Column="1"
        Width="200"
        VerticalAlignment="Center"
        AcceptsReturn="False"
        MaxLength="64"
        PlaceholderText="宏名称"
        TextWrapping="NoWrap"
        ToolTipService.ToolTip="宏名称"
        Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
      />
      <ComboBox
        Grid.Column="2"
        MinWidth="88"
        VerticalAlignment="Center"
        ToolTipService.ToolTip="运行方式"
        SelectedIndex="{Binding ModeIndex, Mode=TwoWay}"
      >
        <ComboBoxItem Content="一次" />
        <ComboBoxItem Content="切换" />
        <ComboBoxItem Content="按住" />
      </ComboBox>
      <Border
        Grid.Column="3"
        Height="32"
        Padding="10,0"
        VerticalAlignment="Center"
        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
        CornerRadius="{ThemeResource ControlCornerRadius}"
        ToolTipService.ToolTip="总延迟"
      >
        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
          <FontIcon
            Glyph="&#xE916;"
            FontSize="14"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          />
          <TextBlock
            VerticalAlignment="Center"
            Text="{Binding TotalDurationDisplay}"
            FontWeight="SemiBold"
          />
        </StackPanel>
      </Border>
      <CommandBar
        Grid.Column="5"
        HorizontalAlignment="Right"
        VerticalAlignment="Center"
        Background="Transparent"
        DefaultLabelPosition="Right"
        IsDynamicOverflowEnabled="False"
        IsEnabled="{x:Bind ViewModel.CanChangeWorkspace, Mode=OneWay}"
      >
        <AppBarButton
          x:Name="RecordButton"
          Label="{x:Bind ViewModel.RecordButtonLabel, Mode=OneWay}"
          Click="RecordButton_Click"
          SizeChanged="RecordButton_SizeChanged"
        >
          <AppBarButton.Icon>
            <FontIcon Glyph="{x:Bind ViewModel.RecordButtonGlyph, Mode=OneWay}" />
          </AppBarButton.Icon>
        </AppBarButton>
        <AppBarButton
          Icon="Clock"
          Label="延迟"
          Command="{x:Bind ViewModel.AddDelayCommand}"
          IsEnabled="{x:Bind ViewModel.CanEditSequence, Mode=OneWay}"
        />
        <AppBarButton
          Icon="Edit"
          Label="注释"
          Command="{x:Bind ViewModel.AddNoteCommand}"
          IsEnabled="{x:Bind ViewModel.CanEditSequence, Mode=OneWay}"
        />
        <AppBarSeparator />
        <AppBarButton
          Icon="Save"
          Label="保存"
          Command="{x:Bind ViewModel.SaveMacroCommand}"
          IsEnabled="{x:Bind ViewModel.CanSaveSelectedMacro, Mode=OneWay}"
        >
          <AppBarButton.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="S" />
          </AppBarButton.KeyboardAccelerators>
        </AppBarButton>
        <CommandBar.SecondaryCommands>
          <AppBarButton
            Icon="Copy"
            Label="复制宏"
            Command="{x:Bind ViewModel.CopyMacroCommand}"
            IsEnabled="{x:Bind ViewModel.CanCopySelectedMacro, Mode=OneWay}"
          />
          <AppBarButton
            Icon="Delete"
            Label="删除宏"
            Click="DeleteMacro_Click"
            IsEnabled="{x:Bind ViewModel.CanEditSequence, Mode=OneWay}"
          />
        </CommandBar.SecondaryCommands>
      </CommandBar>
    </Grid>

    <ContentControl
      x:Name="ContentHost"
      Grid.Row="2"
      HorizontalContentAlignment="Stretch"
      VerticalContentAlignment="Stretch"
    >
      <ContentControl.ContentTransitions>
        <TransitionCollection>
          <ContentThemeTransition VerticalOffset="16" />
        </TransitionCollection>
      </ContentControl.ContentTransitions>
    </ContentControl>

    <InfoBar
      Grid.RowSpan="3"
      Margin="16"
      MaxWidth="640"
      HorizontalAlignment="Right"
      VerticalAlignment="Bottom"
      IsClosable="True"
      IsOpen="{x:Bind ViewModel.IsMessageOpen, Mode=TwoWay}"
      Severity="{x:Bind ViewModel.MessageSeverity, Mode=OneWay}"
    >
      <TextBlock
        MaxWidth="560"
        IsTextSelectionEnabled="True"
        Text="{x:Bind ViewModel.Message, Mode=OneWay}"
        TextWrapping="Wrap"
      />
    </InfoBar>
  </Grid>
</Window>

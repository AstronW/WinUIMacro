<?xml version="1.0" encoding="utf-8"?>
<!-- 宏列表页面：宏展示、新建入口和空状态。 -->
<Page
  x:Class="WinUIMacro.UI.Views.MacroListPage"
  x:Name="RootPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:WinUIMacro.UI.ViewModels"
>
  <Grid Padding="20,12,20,0" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid ColumnSpacing="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button
        Style="{ThemeResource AccentButtonStyle}"
        Click="AddMacro_Click"
        IsEnabled="{x:Bind ViewModel.CanChangeWorkspace, Mode=OneWay}"
      >
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE710;" FontSize="14" />
          <TextBlock Text="新建宏" />
        </StackPanel>
        <Button.KeyboardAccelerators>
          <KeyboardAccelerator Modifiers="Control" Key="N" />
        </Button.KeyboardAccelerators>
      </Button>
      <Button
        Grid.Column="2"
        Width="36"
        Height="32"
        Padding="0"
        Background="Transparent"
        BorderBrush="Transparent"
        Command="{x:Bind ViewModel.RefreshMacrosCommand}"
        ToolTipService.ToolTip="刷新"
      >
        <FontIcon Glyph="&#xE72C;" FontSize="14" />
        <Button.KeyboardAccelerators>
          <KeyboardAccelerator Key="F5" />
        </Button.KeyboardAccelerators>
      </Button>
      <Button
        Grid.Column="3"
        Width="36"
        Height="32"
        Padding="0"
        Background="Transparent"
        BorderBrush="Transparent"
        Command="{x:Bind ViewModel.OpenMacroFolderCommand}"
        ToolTipService.ToolTip="打开宏文件夹"
      >
        <FontIcon Glyph="&#xE838;" FontSize="14" />
      </Button>
    </Grid>
    <GridView
      x:Name="MacroGrid"
      Grid.Row="1"
      Padding="0,0,0,12"
      ItemsSource="{x:Bind ViewModel.Macros, Mode=OneWay}"
      SelectionMode="None"
      IsItemClickEnabled="True"
      IsEnabled="{x:Bind ViewModel.CanChangeWorkspace, Mode=OneWay}"
      ItemClick="MacroGrid_ItemClick"
    >
      <GridView.ItemContainerStyle>
        <Style TargetType="GridViewItem">
          <Setter Property="Width" Value="240" />
          <Setter Property="Height" Value="64" />
          <Setter Property="Margin" Value="0,0,8,8" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
      </GridView.ItemContainerStyle>
      <GridView.ItemTemplate>
        <DataTemplate x:DataType="vm:MacroEditorViewModel">
          <Border
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource OverlayCornerRadius}"
          >
            <Grid>
              <Border
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Opacity="{x:Bind BoundBackgroundOpacity, Mode=OneWay}"
              />
              <Grid Padding="12,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                  Width="36"
                  Height="36"
                  VerticalAlignment="Center"
                  Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                  CornerRadius="{ThemeResource ControlCornerRadius}"
                >
                  <FontIcon
                    Glyph="&#xE945;"
                    FontSize="16"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                  />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                  <TextBlock
                    FontWeight="SemiBold"
                    Text="{x:Bind DisplayName, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                  />
                  <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind BindingSummary, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                  />
                </StackPanel>
              </Grid>
            </Grid>
          </Border>
        </DataTemplate>
      </GridView.ItemTemplate>
    </GridView>
    <StackPanel
      Grid.Row="1"
      Margin="0,0,0,48"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      Spacing="8"
      IsHitTestVisible="False"
      Visibility="{x:Bind ViewModel.HasNoMacros, Mode=OneWay}"
    >
      <FontIcon
        Glyph="&#xE945;"
        FontSize="40"
        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
      />
      <TextBlock
        HorizontalAlignment="Center"
        FontSize="16"
        FontWeight="SemiBold"
        Text="还没有宏"
      />
      <TextBlock
        HorizontalAlignment="Center"
        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
        Text="点击“新建宏”录制第一组键鼠操作"
      />
    </StackPanel>
  </Grid>
</Page>
